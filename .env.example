# Local legacy PostgreSQL source. Copy this file to .env for local development.
SENTINELPAY_DB_DSN=postgresql://sentinelpay:sentinelpay_local@localhost:5432/sentinelpay_legacy

# Use the profile configured by AWS CLI. Never place AWS access keys in this file.
AWS_PROFILE=sentinelpay-deployer
AWS_DEFAULT_REGION=ap-south-1
